# Local conda env
env/

# Per-gene lab data: input FASTAs stay local; the README.md and meta.yml
# templates ship with the starter so the folder layout is documented.
data/*/*
!data/*/README.md
!data/*/meta.yml

# Pipeline outputs that contain sequence: not published
results/

# Quarto / knitr build artifacts (rendered HTML in docs/ IS published)
*_files/
*_cache/
.quarto/
_freeze/

# R session
.Rhistory
.RData
.Ruserdata
*.Rproj
.Rproj.user/

# OS
.DS_Store
Thumbs.db
